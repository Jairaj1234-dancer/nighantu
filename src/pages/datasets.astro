---
import Page from '../layouts/Page.astro';
import { abs, rel } from '../lib/site';
import compounds from '../data/compounds.json';
import compositionSummary from '../data/composition-summary.json';
import lexicon from '../data/lexicon.json';
import conceptsData from '../data/concepts.json';
import crosswalk from '../data/afi-crosswalk.json';
import dravyaguna from '../data/dravyaguna.json';
import research from '../data/research.json';
import taxonomy from '../data/taxonomy.json';
import verification from '../data/verification.json';
import safety from '../data/safety.json';
import verseNumbering from '../data/verse-numbering.json';

/**
 * Counts come from the datasets themselves. Typed-in figures on this page were already
 * stale (22,176 edges against 22,069 actual), and a catalogue that misstates its own row
 * counts is the one thing a data consumer cannot forgive.
 */
const n = (x: number) => x.toLocaleString('en-GB');
const taxaCount = ((taxonomy as any).taxa ?? []).length;
/**
 * Counted from safety.json, which is what is actually published, and not from a verification run.
 *
 * This line used to read the `published` field off the first run whose id matched /safety/. Two
 * things were wrong with it and both produced the same silent zero. The stats live under
 * `run.stats`, so `run.published` was always undefined and `?? 0` turned that into a figure; and
 * the first matching run is safety-panel-01, which genuinely published nothing, so even with the
 * right path the page would have advertised zero while five records were live. The catalogue said
 * "0 published safety records" for as long as it has existed.
 *
 * Same shape as the ncbiTaxId/ncbiTaxid mistake found earlier in this project: a wrong key, a
 * forgiving default, and a wrong number published without anything failing.
 *
 * The two kinds are counted apart because they are different claims. A substantive record states
 * contraindications and interactions from a confirmed source. An insufficient-data record states
 * that no permitted source covers this drug, which is a finding worth publishing and not an empty
 * profile.
 */
const vn = (verseNumbering as any).summary;
const vnOffsets = ((verseNumbering as any).offsetsObserved ?? []) as any[];
const safetyAll = Object.values(((safety as any).records ?? {})) as any[];
const safetySubstantive = safetyAll.filter((r) => !r.insufficientData).length;
const safetyInsufficient = safetyAll.filter((r) => r.insufficientData).length;

const title = 'Open Ayurvedic Datasets';
const description = 'Downloadable machine-readable datasets of classical Ayurvedic pharmacology, Dravyaguna properties, phytochemical constituents, and botanical taxonomy under CC BY 4.0.';
const canonical = '/datasets/';

const composition = compositionSummary as any;
const lex = (lexicon as any).summary;
const con = (conceptsData as any).summary;
const cw = (crosswalk as any).summary;

const datasets = [
  {
    id: 'verse-numbering',
    name: 'Kaviratna and Bhishagratna Verse Numbering against the Standard Editions',
    description: `The only public-domain English Charaka Samhita is Kaviratna's (1896-1913) and the only public-domain English Sushruta is Bhishagratna's (1907-1916). Both number their verses differently from the modern editions every paper cites, and the modern numbering is still in copyright, so a passage read in a free translation cannot be cited in the form scholars use. This records ${vn.publishedAsNumericPairs} verse equivalences between the two, every one of them a statement a source on this site already makes rather than a conversion computed here. There is no formula to replace it: across ${vnOffsets.length} chapters the difference runs from plus six to minus thirteen, two chapters are not internally constant, and some relations map several translator aphorisms onto one standard sutra.`,
    rowCount: `${vn.publishedAsNumericPairs} verse equivalences · ${vnOffsets.length} chapters · ${vn.publishedAsHedged} further equivalences the sources state too loosely to number`,
    browse: '/choosing/citing-the-classical-texts/',
    formats: [
      { ext: 'JSON', path: '/verse-numbering.json', mime: 'application/json' },
      { ext: 'CSV', path: '/verse-numbering.csv', mime: 'text/csv' }
    ]
  },
  {
    id: 'crosswalk',
    name: 'Ayurvedic Formulary of India Ingredient Name Crosswalk',
    description: `The formulary states every official composition in Sanskrit and does not use one name per drug: ${n(cw.ingredientRows)} ingredient rows across the 101 entries transcribed here use ${n(cw.distinctNames)} distinct spellings. Abhaya and Pathya are both haritaki; Marica is black pepper. This resolves ${n(cw.namesResolved)} of those names to a botanical identity, ${n(cw.rowsResolvedViaAPrintedGloss)} rows of it on glosses the book itself prints, and states the basis on every row. ${n(cw.namesAmbiguous)} names the formulary uses for more than one drug are published as ambiguous rather than collapsed, and ${n(cw.namesUnresolved)} as unresolved rather than guessed.`,
    rowCount: `${n(cw.ingredientRows)} ingredient rows · ${n(cw.distinctNames)} distinct names · ${n(cw.plantRowsResolved)} of ${n(cw.plantRows)} plant rows resolved`,
    browse: '/crosswalk/',
    formats: [
      { ext: 'JSON', path: '/afi-crosswalk.json', mime: 'application/json' },
      { ext: 'CSV', path: '/afi-crosswalk.csv', mime: 'text/csv' }
    ]
  },
  {
    id: 'concepts',
    name: 'Contested Questions in Ayurvedic Theory',
    description: `${n(con.contestedQuestions)} questions on which the classical Ayurvedic sources genuinely disagree, across ${n(con.records)} concepts, with ${n(con.attributedPositions)} competing positions given as their sources state them and no position presented as the settled answer. Plus ${n(con.notKnownStatements)} explicit statements of what is not established, ${n(con.classicalCitations)} classical citations of which ${n(con.quotesPublished)} quote the text, and ${n(con.researchItems)} research papers with what each does and does not show. A quotation nobody has read against its source is withheld with the reason stated and the address kept.`,
    rowCount: `${n(con.attributedPositions)} attributed positions across ${n(con.contestedQuestions)} questions · ${n(con.notKnownStatements)} statements of what is not known`,
    browse: '/concept/',
    formats: [
      { ext: 'JSON', path: '/concepts.json', mime: 'application/json' },
      { ext: 'CSV', path: '/concepts.csv', mime: 'text/csv' }
    ]
  },
  {
    id: 'lexicon',
    name: 'Ayurvedic Terminology Lexicon',
    description: `${n(lex.records)} Ayurvedic technical terms and ${n(lex.renderings)} English renderings between them: for each term, every equivalent found in the WHO standard terminologies, the published Samhita translations and the secondary literature, each with its source and an assessment of whether the rendering survives the classical passage it claims to render. ${n(lex.quotesPublished)} classical quotations, every one checked against its source. Renderings from NoDerivs-licensed sources appear on the pages and not in this download; see the licence note inside the file.`,
    rowCount: `${n(lex.renderings)} renderings across ${n(lex.records)} terms · ${n(lex.citations)} classical citations`,
    browse: '/lexicon/',
    formats: [
      { ext: 'JSON', path: '/lexicon.json', mime: 'application/json' },
      { ext: 'CSV', path: '/lexicon.csv', mime: 'text/csv' }
    ]
  },
  {
    id: 'composition',
    name: 'Classical Formulation Composition Dataset',
    description: `The ingredient composition of ${n(composition.formulations)} classical formulations as printed in the Ayurvedic Formulary of India: ${n(composition.ingredientRows)} ingredient rows, ${n(composition.rowsWithQuantity)} of them carrying the quantity the formulary states, each with the plant part used and cited to its formulary part and entry number. A cell that was illegible in the scan is published as illegible rather than guessed, and ${n(composition.rowsWithAnOcrCorrection)} rows carry a correction flagged as the transcriber's rather than the book's.`,
    rowCount: `${n(composition.ingredientRows)} ingredient rows across ${n(composition.formulations)} formulations · ${n(composition.rowsIllegibleInScan)} cells illegible in the scan`,
    browse: '/afi/',
    formats: [
      { ext: 'JSON', path: '/composition.json', mime: 'application/json' },
      { ext: 'CSV', path: '/composition.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/composition.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'dravyaguna',
    name: 'Ayurvedic Dravyaguna Pharmacological Dataset',
    description: `Rasa, guna, virya, vipaka and prabhava for ${n((dravyaguna as any).summary.entries)} monographs, parsed from the pages on this site so every value can be checked against the page it came from.`,
    rowCount: `${n((dravyaguna as any).summary.entries)} monographs`,
    formats: [
      { ext: 'JSON', path: '/dravyaguna.json', mime: 'application/json' },
      { ext: 'CSV', path: '/dravyaguna.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/dravyaguna.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'compounds',
    name: 'Phytochemical Constituents & Co-occurrence Network',
    description: `${n((compounds as any).summary.compounds)} constituents named in the published monographs, ${n((compounds as any).summary.linkable)} of them resolved to PubChem, with ${n((compounds as any).summary.edges)} co-occurrence edges computed from the pages themselves.`,
    rowCount: `${n((compounds as any).summary.compounds)} constituents · ${n((compounds as any).summary.edges)} co-occurrences`,
    formats: [
      { ext: 'JSON', path: '/compounds.json', mime: 'application/json' },
      { ext: 'CSV', path: '/compounds.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/compounds.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'research',
    name: 'Biomedical Literature & Classical Research Index',
    description: `${n((research as any).summary.papers)} papers cited on this site, each with its PubMed ID or DOI, cross-referenced to the monographs that cite it.`,
    rowCount: `${n((research as any).summary.papers)} papers`,
    formats: [
      { ext: 'JSON', path: '/research.json', mime: 'application/json' },
      { ext: 'CSV', path: '/research.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/research.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'taxonomy',
    name: 'Verified Botanical Taxonomy & Identifier Crosswalk',
    description: `Botanical names resolved against GBIF, with NCBI taxonomy IDs and Wikidata QIDs where an exact match exists. ${n(taxaCount)} taxa, each carrying the match type so a fuzzy hit is never read as a fact.`,
    rowCount: `${n(taxaCount)} resolved taxa`,
    formats: [
      { ext: 'JSON', path: '/taxonomy.json', mime: 'application/json' },
      { ext: 'Parquet', path: '/parquet/taxonomy.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'verification',
    name: 'Nighantu Editorial Verification Ledger',
    description: 'What was checked, how, and what was thrown out: every verification run with its examined, published and rejected counts, computed from the run artifacts rather than stated.',
    rowCount: `${n(safetyAll.length)} safety records published, ${safetySubstantive} stating a safety profile and ${safetyInsufficient} stating that no permitted source covers the drug, with the rejections behind them`,
    formats: [
      { ext: 'JSON', path: '/verification.json', mime: 'application/json' }
    ]
  }
];

/**
 * The concept DOI, stated once and used in both the prose and the markup.
 *
 * Two independent research passes in October 2026 found the same defect: the page claimed a
 * "persistent research DOI" and never printed it, and no Dataset node carried an `identifier`.
 * Google's Dataset documentation says to "use the identifier property to attach any relevant
 * Digital Object identifiers", and the documented consumers of that are Dataset Search, DataCite
 * Commons and OpenAlex. It is one of the few things in this whole area with a named consumer
 * rather than a vendor assertion behind it.
 */
const ZENODO_CONCEPT_DOI = '10.5281/zenodo.22805684';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'DataCatalog',
    '@id': `${abs('/datasets/')}#catalog`,
    identifier: `https://doi.org/${ZENODO_CONCEPT_DOI}`,
    sameAs: `https://doi.org/${ZENODO_CONCEPT_DOI}`,
    name: 'Age Ayurveda Nighantu Data Catalog',
    description,
    url: abs('/datasets/'),
    publisher: {
      '@type': 'Organization',
      name: 'Age Ayurveda',
      url: 'https://ageayurveda.com'
    },
    dataset: datasets.map((d) => ({
      '@type': 'Dataset',
      '@id': `${abs('/datasets/')}#${d.id}`,
      name: d.name,
      description: d.description,
      url: abs((d as any).browse ?? '/datasets/'),
      identifier: `https://doi.org/${ZENODO_CONCEPT_DOI}`,
      isAccessibleForFree: true,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: {
        '@type': 'Organization',
        name: 'Age Ayurveda'
      },
      distribution: d.formats.map((f) => ({
        '@type': 'DataDownload',
        encodingFormat: f.mime,
        contentUrl: abs(f.path)
      }))
    }))
  }
];
---
<Page title={title} description={description} canonical={canonical} lede="Open, machine-readable datasets of classical Ayurvedic pharmacology, phytochemical compounds, and botanical taxonomy. Published under Creative Commons Attribution 4.0 International (CC BY 4.0)." jsonld={jsonld}>
  <p>
    All datasets published by the Age Ayurveda Nighantu are generated directly from verified monograph
    records and classical texts, preventing drift between the reference text and tabular data.
    Every botanical taxon is resolved against global taxonomic authorities (GBIF, NCBI, Wikidata),
    and every pharmacological property conforms to standard Ayurvedic Pharmacopoeia of India (API) criteria.
  </p>

  <h2>Available Datasets</h2>

  {datasets.map((d) => (
    <section class="dataset-card" style="margin-bottom: 2rem; padding: 1.25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 6px;">
      <h3 style="margin-top: 0;">{d.name}</h3>
      <p>{d.description}</p>
      <p><strong>Coverage:</strong> {d.rowCount}</p>
      {(d as any).browse && (
        <p><strong>Browse it:</strong> <a href={rel((d as any).browse)}>{(d as any).browse}</a></p>
      )}
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <strong>Direct Downloads:</strong>
        {d.formats.map((f) => (
          <a href={rel(f.path)} class="button" style="display: inline-block; padding: 0.25rem 0.6rem; background: var(--surface-2, #edf2f7); border-radius: 4px; text-decoration: none; font-weight: 600; font-size: 0.85rem;">
            {f.ext}
          </a>
        ))}
      </div>
    </section>
  ))}

  <h2>Archive, identifier and licence</h2>
  <p>
    The corpus is archived on Zenodo under a concept DOI, which always resolves to the newest
    deposit. Cite that one unless you need a specific version.
  </p>
  <p class="caveat">
    <strong>What the DOI actually resolves to, stated plainly because it is not what you would
    expect.</strong> The deposit holds one file: a 7.5 MB archive of this project's repository, from
    which every dataset above is built. It does not hold the JSON, CSV and Parquet files as separate
    downloadable records, and no dataset here has a DOI minted for it alone. So the DOI identifies
    the work that contains these datasets rather than any one of them, which is why each Dataset
    record on this site carries it alongside an <code>isPartOf</code> pointing at this catalogue. If
    you want a specific file, take it from the direct download above, which is the same bytes and
    needs no unpacking. Depositing the data files as their own records is a known gap and the right
    fix; it has not been done yet.
  </p>
  <ul>
    <li>
      <strong>Concept DOI:</strong>
      <a href={`https://doi.org/${ZENODO_CONCEPT_DOI}`} rel="noopener">{ZENODO_CONCEPT_DOI}</a>
      (all versions)
    </li>
    <li><strong>Licensing:</strong> Creative Commons Attribution 4.0 International (CC BY 4.0). Derived in part from the Amidha Ayurveda Herb Database.</li>
  </ul>
  <p class="disclaimer">
    An earlier version of this page advertised a Hugging Face dataset at
    <code>ageayurveda/nighantu</code> and a <code>load_dataset</code> call for it. That repository
    is not public: the request returns 401, so the call never worked for anyone but us. The claim
    is removed rather than left standing, because a dataset page that misstates how to get the
    data is the one thing a data consumer tests first. The files above are the whole corpus and
    need no account.
  </p>

  <h2>What is in every record</h2>
  <p>
    Each dataset carries an <code>attribution</code> block naming the source, the licence and the
    citation to use. Every individual record also carries a <code>source</code> field with the URL
    of the page it is displayed on, so a partial extract can still be credited without anyone
    having to come back here to work out where it came from. Use it: it is the quickest way to
    comply with the licence.
  </p>
  <p>
    Records also carry a <code>canary</code> field. It is an opaque token, unique to the record and
    to this publication, and it exists so that a copy can be identified as one. It encodes nothing
    about the record and is safe to keep; if you are reusing these datasets under CC BY 4.0 with
    attribution, as the licence allows and as we would like, it costs you nothing and we will never
    have cause to look for it.
  </p>

  <h2>Citation & Academic Attribution</h2>
  <p>If you use these datasets in academic research, AI model training, or retrieval-augmented generation systems, please cite:</p>
  <pre style="padding: 1rem; background: var(--surface-2, #f7fafc); border-radius: 6px; overflow-x: auto;"><code>@dataset&#123;age_ayurveda_nighantu_2026,
  author       = &#123;Age Ayurveda&#125;,
  title        = &#123;Age Ayurveda Nighantu: Open Classical Materia Medica and Dravyaguna Dataset&#125;,
  year         = 2026,
  publisher    = &#123;Zenodo&#125;,
  doi          = &#123;{ZENODO_CONCEPT_DOI}&#125;,
  license      = &#123;CC BY 4.0&#125;,
  url          = &#123;https://nighantu.ageayurveda.com/datasets/&#125;
&#125;</code></pre>
  <p class="disclaimer">
    Three things in this citation were wrong and are corrected. It named Hugging Face as a
    publisher of a repository that is not public. It omitted the DOI, which is the only part of a
    dataset citation that is designed to keep working. And it credited "Age Ayurveda Research Panel
    and Amidha Ayurveda" as authors, while the Zenodo record and CITATION.cff both say
    "Age Ayurveda": Amidha is an upstream CC BY source this work attributes, not an author of it.
    One creator string now, matching the archive.
  </p>
</Page>
