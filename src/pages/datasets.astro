---
import Page from '../layouts/Page.astro';
import { abs, rel } from '../lib/site';
import compounds from '../data/compounds.json';
import compositionSummary from '../data/composition-summary.json';
import dravyaguna from '../data/dravyaguna.json';
import research from '../data/research.json';
import taxonomy from '../data/taxonomy.json';
import verification from '../data/verification.json';

/**
 * Counts come from the datasets themselves. Typed-in figures on this page were already
 * stale (22,176 edges against 22,069 actual), and a catalogue that misstates its own row
 * counts is the one thing a data consumer cannot forgive.
 */
const n = (x: number) => x.toLocaleString('en-GB');
const taxaCount = ((taxonomy as any).taxa ?? []).length;
const safetyRecords = (verification as any).runs?.find((r: any) => /safety/i.test(r.id))?.published ?? 0;

const title = 'Open Ayurvedic Datasets';
const description = 'Downloadable machine-readable datasets of classical Ayurvedic pharmacology, Dravyaguna properties, phytochemical constituents, and botanical taxonomy under CC BY 4.0.';
const canonical = '/datasets/';

const composition = compositionSummary as any;

const datasets = [
  {
    id: 'composition',
    name: 'Classical Formulation Composition Dataset',
    description: `The ingredient composition of ${n(composition.formulations)} classical formulations as printed in the Ayurvedic Formulary of India: ${n(composition.ingredientRows)} ingredient rows, ${n(composition.rowsWithQuantity)} of them carrying the quantity the formulary states, each with the plant part used and cited to its formulary part and entry number. A cell that was illegible in the scan is published as illegible rather than guessed, and ${n(composition.rowsWithAnOcrCorrection)} rows carry a correction flagged as the transcriber's rather than the book's.`,
    rowCount: `${n(composition.ingredientRows)} ingredient rows across ${n(composition.formulations)} formulations · ${n(composition.rowsIllegibleInScan)} cells illegible in the scan`,
    browse: '/afi/',
    formats: [
      { ext: 'JSON', path: '/composition.json', mime: 'application/json' },
      { ext: 'CSV', path: '/composition.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/composition.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'dravyaguna',
    name: 'Ayurvedic Dravyaguna Pharmacological Dataset',
    description: `Rasa, guna, virya, vipaka and prabhava for ${n((dravyaguna as any).summary.entries)} monographs, parsed from the pages on this site so every value can be checked against the page it came from.`,
    rowCount: `${n((dravyaguna as any).summary.entries)} monographs`,
    formats: [
      { ext: 'JSON', path: '/dravyaguna.json', mime: 'application/json' },
      { ext: 'CSV', path: '/dravyaguna.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/dravyaguna.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'compounds',
    name: 'Phytochemical Constituents & Co-occurrence Network',
    description: `${n((compounds as any).summary.compounds)} constituents named in the published monographs, ${n((compounds as any).summary.linkable)} of them resolved to PubChem, with ${n((compounds as any).summary.edges)} co-occurrence edges computed from the pages themselves.`,
    rowCount: `${n((compounds as any).summary.compounds)} constituents · ${n((compounds as any).summary.edges)} co-occurrences`,
    formats: [
      { ext: 'JSON', path: '/compounds.json', mime: 'application/json' },
      { ext: 'CSV', path: '/compounds.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/compounds.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'research',
    name: 'Biomedical Literature & Classical Research Index',
    description: `${n((research as any).summary.papers)} papers cited on this site, each with its PubMed ID or DOI, cross-referenced to the monographs that cite it.`,
    rowCount: `${n((research as any).summary.papers)} papers`,
    formats: [
      { ext: 'JSON', path: '/research.json', mime: 'application/json' },
      { ext: 'CSV', path: '/research.csv', mime: 'text/csv' },
      { ext: 'Parquet', path: '/parquet/research.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'taxonomy',
    name: 'Verified Botanical Taxonomy & Identifier Crosswalk',
    description: `Botanical names resolved against GBIF, with NCBI taxonomy IDs and Wikidata QIDs where an exact match exists. ${n(taxaCount)} taxa, each carrying the match type so a fuzzy hit is never read as a fact.`,
    rowCount: `${n(taxaCount)} resolved taxa`,
    formats: [
      { ext: 'JSON', path: '/taxonomy.json', mime: 'application/json' },
      { ext: 'Parquet', path: '/parquet/taxonomy.parquet', mime: 'application/vnd.apache.parquet' }
    ]
  },
  {
    id: 'verification',
    name: 'Nighantu Editorial Verification Ledger',
    description: 'What was checked, how, and what was thrown out: every verification run with its examined, published and rejected counts, computed from the run artifacts rather than stated.',
    rowCount: `${n(safetyRecords)} published safety records, and the rejections behind them`,
    formats: [
      { ext: 'JSON', path: '/verification.json', mime: 'application/json' }
    ]
  }
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'DataCatalog',
    '@id': `${abs('/datasets/')}#catalog`,
    name: 'Age Ayurveda Nighantu Data Catalog',
    description,
    url: abs('/datasets/'),
    publisher: {
      '@type': 'Organization',
      name: 'Age Ayurveda',
      url: 'https://ageayurveda.com'
    },
    dataset: datasets.map((d) => ({
      '@type': 'Dataset',
      '@id': `${abs('/datasets/')}#${d.id}`,
      name: d.name,
      description: d.description,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: {
        '@type': 'Organization',
        name: 'Age Ayurveda'
      },
      distribution: d.formats.map((f) => ({
        '@type': 'DataDownload',
        encodingFormat: f.mime,
        contentUrl: abs(f.path)
      }))
    }))
  }
];
---
<Page title={title} description={description} canonical={canonical} lede="Open, machine-readable datasets of classical Ayurvedic pharmacology, phytochemical compounds, and botanical taxonomy. Published under Creative Commons Attribution 4.0 International (CC BY 4.0)." jsonld={jsonld}>
  <p>
    All datasets published by the Age Ayurveda Nighantu are generated directly from verified monograph
    records and classical texts, preventing drift between the reference text and tabular data.
    Every botanical taxon is resolved against global taxonomic authorities (GBIF, NCBI, Wikidata),
    and every pharmacological property conforms to standard Ayurvedic Pharmacopoeia of India (API) criteria.
  </p>

  <h2>Available Datasets</h2>

  {datasets.map((d) => (
    <section class="dataset-card" style="margin-bottom: 2rem; padding: 1.25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 6px;">
      <h3 style="margin-top: 0;">{d.name}</h3>
      <p>{d.description}</p>
      <p><strong>Coverage:</strong> {d.rowCount}</p>
      {(d as any).browse && (
        <p><strong>Browse it:</strong> <a href={rel((d as any).browse)}>{(d as any).browse}</a></p>
      )}
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <strong>Direct Downloads:</strong>
        {d.formats.map((f) => (
          <a href={rel(f.path)} class="button" style="display: inline-block; padding: 0.25rem 0.6rem; background: var(--surface-2, #edf2f7); border-radius: 4px; text-decoration: none; font-weight: 600; font-size: 0.85rem;">
            {f.ext}
          </a>
        ))}
      </div>
    </section>
  ))}

  <h2>Hugging Face & Zenodo Access</h2>
  <p>
    The consolidated corpus is also hosted in Apache Parquet format on the Hugging Face Hub and archived with a persistent Concept DOI on Zenodo.
  </p>
  <ul>
    <li><strong>Hugging Face Dataset:</strong> <code>ageayurveda/nighantu</code> (supports direct streaming with <code>datasets.load_dataset("ageayurveda/nighantu")</code>)</li>
    <li><strong>Zenodo Archive:</strong> Persistent research DOI archive under Concept DOI versioning.</li>
    <li><strong>Licensing:</strong> Creative Commons Attribution 4.0 International (CC BY 4.0). Derived in part from the Amidha Ayurveda Herb Database.</li>
  </ul>

  <h2>What is in every record</h2>
  <p>
    Each dataset carries an <code>attribution</code> block naming the source, the licence and the
    citation to use. Every individual record also carries a <code>source</code> field with the URL
    of the page it is displayed on, so a partial extract can still be credited without anyone
    having to come back here to work out where it came from. Use it: it is the quickest way to
    comply with the licence.
  </p>
  <p>
    Records also carry a <code>canary</code> field. It is an opaque token, unique to the record and
    to this publication, and it exists so that a copy can be identified as one. It encodes nothing
    about the record and is safe to keep; if you are reusing these datasets under CC BY 4.0 with
    attribution, as the licence allows and as we would like, it costs you nothing and we will never
    have cause to look for it.
  </p>

  <h2>Citation & Academic Attribution</h2>
  <p>If you use these datasets in academic research, AI model training, or retrieval-augmented generation systems, please cite:</p>
  <pre style="padding: 1rem; background: var(--surface-2, #f7fafc); border-radius: 6px; overflow-x: auto;"><code>@dataset&#123;age_ayurveda_nighantu_2026,
  author       = &#123;Age Ayurveda Research Panel and Amidha Ayurveda&#125;,
  title        = &#123;Age Ayurveda Nighantu: Open Classical Materia Medica and Dravyaguna Dataset&#125;,
  year         = 2026,
  publisher    = &#123;Age Ayurveda / Zenodo / Hugging Face&#125;,
  license      = &#123;CC BY 4.0&#125;,
  url          = &#123;https://nighantu.ageayurveda.com/datasets/&#125;
&#125;</code></pre>
</Page>
