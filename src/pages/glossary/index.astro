---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE_NAME, abs, rel } from '../../lib/site';

const pages = (await getCollection('glossary'))
  .map((e) => e.data)
  .sort((a, b) => a.groupTitle.localeCompare(b.groupTitle) || a.part - b.part);

const groups = [...new Set(pages.map((p) => p.group))].map((g) => ({
  group: g,
  title: pages.find((p) => p.group === g)!.groupTitle,
  parts: pages.filter((p) => p.group === g),
}));
const total = pages.reduce((n, p) => n + p.entryCount, 0);

const description = `${total} short definitions for the compounds, plant families, pharmacological actions and Ayurvedic concepts referenced across the Atlas monographs.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Glossary · ${SITE_NAME}`,
  description,
  url: abs('/glossary/'),
  isPartOf: { '@id': `${abs('/')}#website` },
};
---
<Base title={`Glossary · ${SITE_NAME}`} description={description} canonical="/glossary/" jsonld={jsonld} wide>
  <Crumbs trail={[{ label: 'Glossary' }]} />
  <h1>Glossary</h1>
  <p class="lede">{description}</p>
  <p><span class="pill">{total} definitions</span></p>

  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <ul class="grid">
        {g.parts.map((p) => (
          <li class="card">
            <a href={rel(`/glossary/${p.slug}/`)}>{p.partCount > 1 ? p.range : p.groupTitle}</a>
            <p>{p.entryCount} entries</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
