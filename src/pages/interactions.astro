---
import Page from '../layouts/Page.astro';
import { abs, rel } from '../lib/site';

const title = 'Herb-Drug & CYP450 Pharmacokinetic Interactions';
const description = 'Clinical reference matrix of Ayurvedic botanicals, cytochrome P450 (CYP450) enzyme modulation, P-glycoprotein efflux transport, and pharmaceutical drug interactions.';
const canonical = '/interactions/';

const interactions = [
  {
    herb: 'Pippali / Black Pepper',
    botanical: 'Piper longum / Piper nigrum',
    slug: 'pippali',
    active: 'Piperine',
    enzymes: 'CYP3A4 (inhibition), CYP2D6 (inhibition), CYP1A2 (inhibition), P-gp (efflux inhibition)',
    drugs: 'Simvastatin, Cyclosporine, Carbamazepine, Midazolam, Anticoagulants',
    severity: 'Major / Bioenhancer',
    effect: 'Inhibits first-pass hepatic metabolism and intestinal efflux, increasing systemic AUC of co-administered drugs by 30% to 200%. Known classically as the premier Yogavahi bioenhancer.'
  },
  {
    herb: 'Haridra (Turmeric)',
    botanical: 'Curcuma longa',
    slug: 'haridra',
    active: 'Curcumin, Curcuminoids',
    enzymes: 'CYP3A4 (moderate inhibition), CYP1A2, CYP2B6, P-gp',
    drugs: 'Warfarin, Aspirin, Clopidogrel, Sulfonylureas, Metformin',
    severity: 'Moderate',
    effect: 'Additive antiplatelet and hypoglycemic effects. Inhibits platelet aggregation (TXA2 synthesis suppression) and potentiates anticoagulant actions.'
  },
  {
    herb: 'Ashwagandha',
    botanical: 'Withania somnifera',
    slug: 'ashwagandha',
    active: 'Withanolides, Withaferin A',
    enzymes: 'Mild CYP3A4 substrate; GABA-A receptor modulation',
    drugs: 'Levothyroxine, Sedatives (Benzodiazepines, Zolpidem), Immunosuppressants',
    severity: 'Moderate',
    effect: 'Additive central nervous system sedation; elevates circulating T3 and T4 levels (monitored in thyroid replacement therapy); immunostimulatory properties may counteract immunosuppressants.'
  },
  {
    herb: 'Arjuna',
    botanical: 'Terminalia arjuna',
    slug: 'arjuna',
    active: 'Arjunic acid, Arjunetin, Flavonoids',
    enzymes: 'CYP3A4 (inhibition), CYP2D6, CYP2C9 in human liver microsomes',
    drugs: 'Statins (Atorvastatin, Simvastatin), Calcium Channel Blockers, Digoxin',
    severity: 'Moderate',
    effect: 'In-vitro microsomal inhibition alters clearance of narrow therapeutic index cardiovascular drugs; synergistic inotropy and blood pressure lowering requires clinical monitoring.'
  },
  {
    herb: 'Guggulu',
    botanical: 'Commiphora mukul',
    slug: 'guggulu',
    active: 'Guggulsterones (E and Z)',
    enzymes: 'CYP3A4 (induction via PXR activation)',
    drugs: 'Oral contraceptives, Cyclosporine, Statin medications',
    severity: 'Major',
    effect: 'Pregnane X receptor (PXR) agonist, accelerating hepatic CYP3A4 clearance and potentially reducing therapeutic plasma concentrations of co-administered medications.'
  },
  {
    herb: 'Gokshura',
    botanical: 'Tribulus terrestris',
    slug: 'gokshura',
    active: 'Protodioscin, Furostanol saponins',
    enzymes: 'CYP3A4 (moderate inhibition)',
    drugs: 'Statins, Antihypertensives, ACE inhibitors, Diuretics',
    severity: 'Moderate',
    effect: 'Documented clinical interactions with atorvastatin metabolism; additive hypotensive and diuretic actions when co-prescribed with prescription loop or thiazide diuretics.'
  },
  {
    herb: 'Yashtimadhu',
    botanical: 'Glycyrrhiza glabra',
    slug: 'yashtimadhu',
    active: 'Glycyrrhizin, Glycyrrhetinic acid',
    enzymes: '11-beta-HSD2 inhibition; mild CYP3A4 and CYP2C9 modulation',
    drugs: 'Corticosteroids, Digoxin, Thiazide diuretics, Antihypertensives',
    severity: 'Major (high doses)',
    effect: 'Inhibition of 11-beta-hydroxysteroid dehydrogenase type 2 causes pseudo-hyperaldosteronism with sodium retention, potassium loss, and blunted antihypertensive therapy.'
  },
  {
    herb: 'Kalmegh (Bhunimba)',
    botanical: 'Andrographis paniculata',
    slug: 'bhunimba',
    active: 'Andrographolide',
    enzymes: 'CYP1A2 (induction), CYP2C9 (inhibition), CYP3A4 (mild inhibition)',
    drugs: 'Warfarin, Theophylline, Acetaminophen, Antidiabetics',
    severity: 'Moderate',
    effect: 'Alters hepatic clearance of CYP1A2 and CYP2C9 substrates. Additive antiplatelet actions warrant caution before surgical procedures.'
  },
  {
    herb: 'Daruharidra',
    botanical: 'Berberis aristata',
    slug: 'daruharidra',
    active: 'Berberine',
    enzymes: 'CYP3A4 (potent inhibition), CYP2D6, CYP2C9, P-gp inhibition',
    drugs: 'Cyclosporine, Clarithromycin, Midazolam, Metformin, Statins',
    severity: 'Major',
    effect: 'Significant inhibition of CYP3A4 and P-glycoprotein elevates systemic exposure (AUC) of immunosuppressants and macrolides by up to 2- to 3-fold.'
  },
  {
    herb: 'Triphala',
    botanical: 'Emblica officinalis, Terminalia chebula, Terminalia bellirica',
    slug: 'triphala',
    active: 'Chebulagic acid, Gallic acid, Ellagic acid',
    enzymes: 'CYP3A4 and CYP2D6 mild down-regulation; P-gp modulation',
    drugs: 'Antidiabetics, Anticoagulants, Mineral supplements',
    severity: 'Minor to Moderate',
    effect: 'Dense polyphenol and tannin matrix binds co-administered oral iron and metal ions, reducing mineral absorption; mild synergistic blood glucose lowering.'
  }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${abs('/interactions/')}#webpage`,
  name: title,
  description,
  url: abs('/interactions/'),
  publisher: {
    '@type': 'Organization',
    name: 'Age Ayurveda',
    url: 'https://ageayurveda.com'
  },
  about: {
    '@type': 'MedicalGuideline',
    name: 'Ayurvedic Pharmacokinetics & Drug Interaction Guidelines',
    guidelineSubject: {
      '@type': 'MedicalTherapy',
      name: 'Ayurvedic Botanical Pharmacology'
    }
  }
};
---
<Page title={title} description={description} canonical={canonical} lede="Clinical pharmacokinetic matrix cross-referencing major Ayurvedic botanicals with Cytochrome P450 enzyme modulation, P-glycoprotein transport, and prescription pharmaceutical interactions." jsonld={jsonld}>
  <div style="background: var(--surface-2, #f8fafc); padding: 1.25rem; border-left: 4px solid var(--accent, #3182ce); border-radius: 4px; margin-bottom: 2rem;">
    <h3 style="margin-top: 0;">Direct Clinical Summary</h3>
    <p style="margin-bottom: 0;">
      Ayurvedic botanicals interact with pharmaceutical drugs primarily through Phase I hepatic Cytochrome P450 (CYP)
      enzyme modulation and intestinal P-glycoprotein (P-gp) efflux alteration. Key bioenhancers like Piperine
      potently inhibit CYP3A4 and P-gp, elevating systemic drug bioavailability, while herbs like Guggulu induce CYP3A4
      via PXR activation. Concomitant administration with narrow therapeutic index medications (warfarin, cyclosporine,
      digoxin) requires clinical monitoring and dosage spacing.
    </p>
  </div>

  <h2>Herb-Drug Interaction Reference Table</h2>
  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.95rem;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border, #cbd5e1); text-align: left;">
          <th style="padding: 0.75rem 0.5rem;">Herb & Botanical</th>
          <th style="padding: 0.75rem 0.5rem;">Key Active Marker</th>
          <th style="padding: 0.75rem 0.5rem;">Enzymes & Transporters</th>
          <th style="padding: 0.75rem 0.5rem;">Interacting Drug Classes</th>
          <th style="padding: 0.75rem 0.5rem;">Severity</th>
        </tr>
      </thead>
      <tbody>
        {interactions.map((i) => (
          <tr style="border-bottom: 1px solid var(--border, #e2e8f0);">
            <td style="padding: 0.75rem 0.5rem;">
              <strong><a href={rel(`/herb/${i.slug}/`)}>{i.herb}</a></strong><br />
              <small style="color: var(--text-muted, #64748b);"><em>{i.botanical}</em></small>
            </td>
            <td style="padding: 0.75rem 0.5rem;">{i.active}</td>
            <td style="padding: 0.75rem 0.5rem;"><code>{i.enzymes}</code></td>
            <td style="padding: 0.75rem 0.5rem;">{i.drugs}</td>
            <td style="padding: 0.75rem 0.5rem;">
              <span style={`display: inline-block; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; ${i.severity.startsWith('Major') ? 'background: #fee2e2; color: #991b1b;' : i.severity.startsWith('Moderate') ? 'background: #fef3c7; color: #92400e;' : 'background: #e0f2fe; color: #075985;'}`}>
                {i.severity}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Pharmacokinetic Mechanisms</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div style="padding: 1.25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 6px;">
      <h3 style="margin-top: 0;">1. CYP3A4 & Phase I Metabolism</h3>
      <p style="font-size: 0.9rem; line-height: 1.6;">
        Cytochrome P450 3A4 metabolizes over 50% of prescription pharmaceuticals. Reversible inhibition by piperine,
        berberine, or arjunolic acid suppresses first-pass clearance, elevating circulating peak plasma concentrations (Cmax)
        and area-under-the-curve (AUC). Conversely, guggulsterones activate nuclear PXR receptors, inducing enzyme activity.
      </p>
    </div>

    <div style="padding: 1.25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 6px;">
      <h3 style="margin-top: 0;">2. P-Glycoprotein Efflux Pump</h3>
      <p style="font-size: 0.9rem; line-height: 1.6;">
        P-glycoprotein (ABCB1) actively pumps xenobiotics out of intestinal epithelial cells back into the gut lumen.
        Ayurvedic Yogavahi botanicals (Pippali, Maricha) inhibit P-gp, dramatically increasing the transepithelial flux
        and systemic bioavailability of lipophilic compounds like Curcumin and cyclosporine.
      </p>
    </div>

    <div style="padding: 1.25rem; border: 1px solid var(--border, #e2e8f0); border-radius: 6px;">
      <h3 style="margin-top: 0;">3. Classical Viruddha Ahara</h3>
      <p style="font-size: 0.9rem; line-height: 1.6;">
        Classical Ayurvedic texts detail Viruddha (incompatibility)—substances that clash in potency (Virya Viruddha),
        processing (Samskara Viruddha), or quantitative ratio. Modern pharmacokinetics verifies these principles at the
        biochemical level as antagonistic receptor binding, chelation, and accelerated metabolic clearance.
      </p>
    </div>
  </div>

  <h2>Clinical Practice Guidance</h2>
  <ul>
    <li><strong>Temporal Spacing:</strong> Administer non-bioenhancing Ayurvedic formulations at least 2 to 3 hours apart from critical prescription medications.</li>
    <li><strong>Narrow Therapeutic Index (NTI):</strong> Exercise rigorous monitoring when combining any herbal regimen with warfarin, lithium, digoxin, levothyroxine, or immunosuppressants.</li>
    <li><strong>Surgical Precaution:</strong> Discontinue high-dose Curcumin, Ginkgo, and Garlic extracts at least 7 to 14 days prior to elective surgery due to additive antiplatelet effects.</li>
  </ul>
</Page>
