---
/** The directory's front door: every city with its count. */
import Page from '../../layouts/Page.astro';
import { cities, practices, updatedAt } from '../../lib/practitioners';
import { rel } from '../../lib/site';
const all = cities();
const title = 'Ayurvedic practitioners in India: a directory with verified address and phone';
const description = `${practices.length} Ayurvedic practices in ${all.length} ${all.length === 1 ? 'city' : 'cities'}, each listed only when a named practitioner, the practice name, a full address and a business phone number are published by the practice itself or an official list.`;
---
<Page title={title} description={description} canonical="/practitioners/" updated={updatedAt} trail={[{ label: 'Practitioners' }]}>
  <h1>Ayurvedic practitioners</h1>
  <p class="answer">{description}</p>
  <ul>{all.map((c) => <li><a href={rel(`/practitioners/${c.slug}/`)}>{c.name}</a>: {c.localities.reduce((a, l) => a + l.practices.length, 0)} practices in {c.localities.length} localities</li>)}</ul>
  <p>Starting with Mumbai, then the other largest cities. <a href={rel('/practitioners/about/')}>How the directory is made, and how to correct or remove a listing</a>.</p>
</Page>
