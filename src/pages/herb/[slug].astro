---
import { getCollection, render } from 'astro:content';
import Monograph from '../../layouts/Monograph.astro';

export async function getStaticPaths() {
  const entries = await getCollection('herb');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Monograph entry={entry} headings={headings} sectionLabel="Herbs" sectionHref="/herb/">
  <Content />
</Monograph>
