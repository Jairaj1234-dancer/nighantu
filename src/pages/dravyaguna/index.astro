---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import dg from '../../data/dravyaguna.json';
import { SITE_NAME, abs, rel } from '../../lib/site';

const { summary, entries, english, updatedAt } = dg as any;

const description = `Rasa, guna, virya and vipaka for ${summary.entries} Ayurvedic dravyas and `
  + `formulations, as structured data rather than prose. Browse by property or download the whole set.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    '@id': `${abs('/dravyaguna/')}#dataset`,
    name: 'Age Ayurveda Nighantu Dravyaguna dataset',
    description,
    url: abs('/dravyaguna/'),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isAccessibleForFree: true,
    inLanguage: 'en',
    creator: { '@id': `${abs('/')}#organization` },
    publisher: { '@id': `${abs('/')}#organization` },
    variableMeasured: ['rasa', 'guna', 'virya', 'vipaka', 'prabhava', 'dosha effect'],
    keywords: ['Ayurveda', 'Dravyaguna', 'rasa', 'virya', 'vipaka', 'materia medica', 'pharmacology'],
    distribution: [
      { '@type': 'DataDownload', name: 'JSON', encodingFormat: 'application/json', contentUrl: abs('/dravyaguna.json') },
      { '@type': 'DataDownload', name: 'CSV', encodingFormat: 'text/csv', contentUrl: abs('/dravyaguna.csv') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nighantu', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Dravyaguna', item: abs('/dravyaguna/') },
    ],
  },
];

const facet = (kind: string, tally: Record<string, number>) =>
  Object.entries(tally).map(([value, n]) => ({
    value, n, href: rel(`/dravyaguna/${kind}-${value.toLowerCase()}/`),
    gloss: (english as Record<string, string>)[value] ?? '',
  }));

const rasa = facet('rasa', summary.byRasa);
const virya = facet('virya', summary.byVirya);
const vipaka = facet('vipaka', summary.byVipaka);
const guna = facet('guna', summary.byGuna);
---
<Base title={`Dravyaguna · ${SITE_NAME}`} description={description} canonical="/dravyaguna/" jsonld={jsonld} wide>
  <Crumbs trail={[{ label: 'Dravyaguna' }]} />
  <h1>Dravyaguna</h1>

  <p class="answer">
    Dravyaguna is the classical pharmacology of Ayurvedic materials: the taste (rasa), physical
    quality (guna), potency (virya) and post-digestive effect (vipaka) of a substance, plus any
    action that does not follow from those (prabhava). This page carries those properties for
    {summary.entries} entries as structured, downloadable data.
  </p>

  <p class="lede">
    The properties were already stated on individual pages, in a table a person could read and
    nothing could query. Held as data they answer the question the framework is actually for:
    which substances share a potency, which cross a taste with a post-digestive effect.
  </p>

  <table class="facts">
    <caption>Coverage</caption>
    <tbody>
      <tr><th scope="row">Entries</th><td>{summary.entries}</td></tr>
      <tr><th scope="row">With rasa</th><td>{summary.withRasa}</td></tr>
      <tr><th scope="row">With virya</th><td>{summary.withVirya}</td></tr>
      <tr><th scope="row">With vipaka</th><td>{summary.withVipaka}</td></tr>
      <tr><th scope="row">With guna</th><td>{summary.withGuna}</td></tr>
      <tr><th scope="row">With a stated dosha effect</th><td>{summary.withDosha}</td></tr>
    </tbody>
  </table>

  <h2>Browse by potency (virya)</h2>
  <ul class="grid">
    {virya.map((f) => (
      <li class="card">
        <a href={f.href}>{f.value}</a>
        <p>{f.gloss && <>{f.gloss}. </>}<strong>{f.n}</strong> entries.</p>
      </li>
    ))}
  </ul>

  <h2>Browse by taste (rasa)</h2>
  <ul class="grid">
    {rasa.map((f) => (
      <li class="card">
        <a href={f.href}>{f.value}</a>
        <p>{f.gloss && <>{f.gloss}. </>}<strong>{f.n}</strong> entries.</p>
      </li>
    ))}
  </ul>

  <h2>Browse by post-digestive effect (vipaka)</h2>
  <ul class="grid">
    {vipaka.map((f) => (
      <li class="card">
        <a href={f.href}>{f.value}</a>
        <p>{f.gloss && <>{f.gloss}. </>}<strong>{f.n}</strong> entries.</p>
      </li>
    ))}
  </ul>

  <h2>Browse by quality (guna)</h2>
  <ul class="grid">
    {guna.map((f) => (
      <li class="card">
        <a href={f.href}>{f.value}</a>
        <p>{f.gloss && <>{f.gloss}. </>}<strong>{f.n}</strong> entries.</p>
      </li>
    ))}
  </ul>

  <h2>Everything, in one table</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>Entry</th><th>Rasa</th><th>Virya</th><th>Vipaka</th><th>Guna</th></tr>
      </thead>
      <tbody>
        {entries.map((e: any) => (
          <tr>
            <td><a href={rel(`/${e.kind}/${e.slug}/`)}>{e.title}</a>{e.botanical && <> <em class="bot">{e.botanical}</em></>}</td>
            <td>{e.rasa.join(', ')}</td>
            <td>{e.virya}</td>
            <td>{e.vipaka.join(', ')}</td>
            <td>{e.guna.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Download</h2>
  <p>
    <a href={rel('/dravyaguna.json')}>dravyaguna.json</a> and
    <a href={rel('/dravyaguna.csv')}>dravyaguna.csv</a>, free to reuse under CC BY 4.0.
    Values are checked against the classical vocabularies rather than stored as free text, so
    they can be filtered on directly. Anything that did not match a known value was dropped
    rather than guessed at.
  </p>

  <p class="meta">Rebuilt {updatedAt} from the monographs themselves, so this cannot drift from the pages.</p>
</Base>
