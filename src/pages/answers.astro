---
import Page from '../layouts/Page.astro';
import { abs, rel } from '../lib/site';

const title = 'Ayurvedic Reference Q&A';
const description = 'Authoritative, evidence-grounded answers to classical Ayurvedic practice, Shirodhara protocols, botanical pharmacology, and formulation queries.';
const canonical = '/answers/';

const qaItems = [
  // Shirodhara & Clinical
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'What is Shirodhara and where does it come from?',
    a: 'Shirodhara is a classical Ayurvedic therapeutic procedure in which a continuous, rhythmic stream of warm medicated liquid (typically herbal oil, buttermilk, or decoction) is poured onto the forehead (ajna chakra). It originates in the classical Ayurvedic tradition of Kerala and the classical Samhitas, primarily indicated for calming Prana Vata, soothing the central nervous system, and relieving mental fatigue.',
    link: '/shirodhara/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'What temperature should Shirodhara oil be?',
    a: 'Shirodhara oil should be maintained strictly at body temperature to lukewarm, between 38°C and 40°C (100°F to 104°F) for Vata and Kapha conditions. In Pitta-dominant aggravation with acute heat or inflammation, cooler or room-temperature medicated milk (Ksheeradhara) or buttermilk (Takradhara) is selected instead.',
    link: '/shirodhara/temperature-and-duration/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'How long does a Shirodhara session last?',
    a: 'A standard therapeutic Shirodhara session lasts between 30 and 45 minutes of continuous stream flow, preceded by a 10-minute head massage (Shiro Abhyanga) and followed by 10 to 15 minutes of quiet rest. Treatment courses typically run for consecutive cycles of 7, 14, or 21 days depending on practitioner evaluation.',
    link: '/shirodhara/session-protocol/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'Which oil is used for Vata Shirodhara?',
    a: 'For Vata constitution and Vata imbalances, warm heavy herbal oils are indicated: classical Ksheerabala Taila, Mahanarayana Taila, Dhanwantharam Taila, or cold-pressed unrefined sesame oil infused with grounding roots like Ashwagandha and Bala.',
    link: '/shirodhara/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'Which oil should be used for a Pitta constitution in Shirodhara?',
    a: 'Pitta imbalances require cooling, sweet, and bitter herbal infusions: Chandanadi Taila (sandalwood), Brahmi Taila in coconut or sesame base, or non-oil media like Takradhara (medicated buttermilk boiled with Musta and Amla) to reduce excess heat and irritability without aggravating digestive agni.',
    link: '/shirodhara/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'Who should not have Shirodhara?',
    a: 'Shirodhara is strictly contraindicated during acute fever (Jwara), severe rhinitis or acute sinusitis (Amanasya), severe indigestion with heavy toxic accumulation (Ama), active head injuries, acute alcohol intoxication, severe neck instability, or full-blown psychotic agitation.',
    link: '/shirodhara/cautions/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'What is the difference between Shirodhara and shiro abhyanga?',
    a: 'Shiro Abhyanga is active manual massage of the scalp, neck, and shoulders using medicated oil with friction, kneading, and marma pressure. Shirodhara is passive hydro-kinetic flow therapy where warm oil streams continuously from a suspended dhara vessel onto the forehead without manual rubbing during the stream.',
    link: '/shirodhara/'
  },
  {
    category: 'Shirodhara Practice & Clinical Protocols',
    q: 'What is takra dhara?',
    a: 'Takradhara is a specialized form of Shirodhara where medicated buttermilk—prepared by boiling milk with Musta (Cyperus rotundus) rhizome decoction, fermenting it into curd, and churning it with Amalaki water—is poured continuously over the forehead. It provides intensive cooling for insomnia, psoriasis, and severe Pitta disorders.',
    link: '/shirodhara/'
  },
  // Equipment & Devices
  {
    category: 'Equipment & Apparatus',
    q: 'What is a dhara patra?',
    a: 'A dhara patra is the traditional suspended vessel used in Shirodhara. Typically crafted from bronze (Kansya), copper, brass, or earthenware, it features an aperture in the base fitted with a cotton wick or valve that regulates a steady, non-turbulent continuous stream onto the forehead.',
    link: '/device/shirodhara-pot-apparatus/'
  },
  {
    category: 'Equipment & Apparatus',
    q: 'Where can I buy a portable Shirodhara machine?',
    a: 'Portable Shirodhara machines designed for home and spa use without fixed plumbing infrastructure are manufactured by specialized Ayurvedic engineering providers, including the Surya Shirodhara automated system by Age Ayurveda, which features integrated oil recirculation and temperature regulation.',
    link: '/shirodhara/choosing-equipment/'
  },
  {
    category: 'Equipment & Apparatus',
    q: 'Is a Shirodhara machine a medical device?',
    a: 'Under Indian medical device regulations and FDA classifications, wellness Shirodhara apparatus and automated pouring stands are generally classified as wellness, spa, and physical therapy apparatus rather than invasive Class II/III medical devices, provided no diagnostic or curative disease claims are made.',
    link: '/shirodhara/choosing-equipment/'
  },
  // Botanicals & Pharmacology
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What is the Ayurvedic category of Ashwagandha?',
    a: 'Ashwagandha (Withania somnifera) is classified as a Balya (strength-promoting), Rasayana (rejuvenative), and Medhya (cognitive-supportive) dravya in classical Dravyaguna. It possesses Tikta-Kashaya-Madhura rasa, Ushna virya, and Madhura vipaka, acting primarily to pacify Vata and Kapha.',
    link: '/herb/ashwagandha/'
  },
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What is the botanical name of Yashtimadhu and what is it used for traditionally?',
    a: 'Yashtimadhu is Glycyrrhiza glabra (licorice) of the Fabaceae family. Traditionally used as a sweet cooling Rasayana (Madhura-Sheeta), it is indicated for soothing mucosal irritation, promoting digestive agni balance, clarifying the voice (Kanthya), and pacifying aggravated Pitta and Vata doshas.',
    link: '/herb/yashtimadhu/'
  },
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What are the main withanolides in Withania somnifera?',
    a: 'The primary bioactive constituents in Withania somnifera are steroidal lactones known as withanolides, prominently withaferin A, withanolide A, withanolide D, and withanoside IV, which modern pharmacological assays correlate with adaptogenic and neuroprotective properties.',
    link: '/herb/ashwagandha/'
  },
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What is the dosha effect of Haridra?',
    a: 'Haridra (Curcuma longa / Turmeric) is Katu and Tikta in taste, Ushna (heating) in potency, and Katu in post-digestive vipaka. It acts strongly to pacify Kapha and Vata, removes metabolic toxins (Ama), and cleanses blood tissue (Rakta Shodhaka).',
    link: '/herb/haridra/'
  },
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What is Guduchi used for in classical Ayurveda?',
    a: 'Guduchi (Tinospora cordifolia) is revered as Amrita (nectar). It possesses Tikta-Kashaya rasa, Ushna virya, and Madhura vipaka. Uniquely tridoshic, it is primarily indicated for chronic metabolic heat, liver support, immune defense (Rasayana), and pacifying Pitta-dominant tissue imbalances.',
    link: '/herb/guduchi/'
  },
  {
    category: 'Botanical Pharmacology (Dravyaguna)',
    q: 'What is the rasa, virya and vipaka of Shatavari?',
    a: 'Shatavari (Asparagus racemosus) has Madhura (sweet) and Tikta (bitter) rasa, Sheeta (cooling) virya, and Madhura (sweet) vipaka. It is a premier female reproductive Rasayana, pacifying Vata and Pitta while nourishing Shukra and Rasa dhatus.',
    link: '/herb/shatavari/'
  },
  // Pharmacy & Formulations
  {
    category: 'Ayurvedic Pharmacy & Formulations',
    q: 'What is an avaleha in Ayurveda?',
    a: 'An avaleha is a classical semi-solid confection or herbal paste prepared by boiling herbal decoctions (Kashaya) or fruit pulps with jaggery, sugar, or honey until reaching a thick, sticky consistency, followed by the addition of aromatic churnas and ghee. Chyawanprash is the foremost classical example.',
    link: '/formulation/chyawanprash/'
  },
  {
    category: 'Ayurvedic Pharmacy & Formulations',
    q: 'What is the difference between a churna and a vati?',
    a: 'A churna is a fine dry powder of one or more herbs sifted through fine cloth (traditionally 80-100 mesh). A vati (or gutika) is a compacted herbal pill or tablet formed by binding churnas with herbal extracts, decoctions, or guggulu resins for exact dosage and prolonged shelf life.',
    link: '/formulation/'
  },
  {
    category: 'Ayurvedic Pharmacy & Formulations',
    q: 'What is Triphala and what is it traditionally used for?',
    a: 'Triphala is a classical tridoshic formulation consisting of equal parts of three dried myrobalan fruits: Amalaki (Phyllanthus emblica), Bibhitaki (Terminalia bellirica), and Haritaki (Terminalia chebula). It is traditionally used as a gentle bowel regulator, digestive agni stimulant, and ocular Rasayana (Chakshushya).',
    link: '/formulation/triphala-churna/'
  },
  // Brand & Nighantu Reference
  {
    category: 'Encyclopedia & Brand Reference',
    q: 'What is a nighantu in Ayurveda?',
    a: 'A Nighantu is a classical Ayurvedic glossary and materia medica text specializing in Dravyaguna (pharmacology). It systematically classifies medicinal plants, minerals, animal substances, and formulations, cataloging their Sanskrit synonyms, regional vernacular names, physical morphology, and pharmacological actions (Rasa, Guna, Virya, Vipaka).',
    link: '/about/'
  },
  {
    category: 'Encyclopedia & Brand Reference',
    q: 'What is the Age Ayurveda Nighantu?',
    a: 'The Age Ayurveda Nighantu is an open, evidence-anchored digital encyclopedia of classical Ayurvedic materia medica. It indexes over 500 botanical monographs, 140 classical formulations, and traditional apparatus, cross-referencing classical Sanskrit texts with modern botanical taxonomic keys (GBIF, NCBI) and PubMed research.',
    link: '/about/'
  },
  {
    category: 'Encyclopedia & Brand Reference',
    q: 'What is Surya Shirodhara?',
    a: 'Surya Shirodhara is an automated, portable Shirodhara wellness system developed under Age Ayurveda and the Shree Baidyanath research lineage. It enables continuous temperature-controlled oil flow without fixed plumbing infrastructure, designed for wellness spas, Ayurvedic clinics, and supervised home practice.',
    link: '/shirodhara/'
  }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${abs('/answers/')}#faq`,
  mainEntity: qaItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${item.a} Verified reference: ${abs(item.link)}`
    }
  }))
};

const categories = [...new Set(qaItems.map((i) => i.category))];
---
<Page title={title} description={description} canonical={canonical} lede="Authoritative, evidence-grounded answers to classical Ayurvedic practice, Shirodhara protocols, botanical pharmacology, and formulation queries." jsonld={jsonld}>
  <p>
    This reference panel provides direct, concise answers compiled from classical Ayurvedic texts
    (Caraka Samhita, Sushruta Samhita, Ashtanga Hridaya, Bhavaprakasha Nighantu) and modern pharmacopoeial
    standards. Every entry links into the complete, citable monograph record in the Nighantu.
  </p>

  {categories.map((cat) => (
    <section style="margin-bottom: 2.5rem;">
      <h2>{cat}</h2>
      {qaItems.filter((i) => i.category === cat).map((i) => (
        <article style="margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border, #e2e8f0);">
          <h3 style="margin-bottom: 0.5rem;">{i.q}</h3>
          <p style="margin-top: 0; line-height: 1.6;">{i.a}</p>
          <p style="font-size: 0.9rem; margin-bottom: 0;">
            <strong>Canonical monograph:</strong> <a href={rel(i.link)}>View full reference & citations &rarr;</a>
          </p>
        </article>
      ))}
    </section>
  ))}
</Page>
