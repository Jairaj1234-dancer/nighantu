---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import verification from '../../data/verification.json';
import { SITE_NAME, abs, rel } from '../../lib/site';

export function getStaticPaths() {
  const { runs } = verification as any;
  return runs.map((r: any) => ({ params: { run: r.id }, props: { run: r } }));
}

const { run } = Astro.props as any;
const s = run.stats ?? {};

const description = `${run.title}: how it was checked and what was rejected. ${run.question}`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nighantu', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Verification', item: abs('/verification/') },
      { '@type': 'ListItem', position: 3, name: run.title, item: abs(`/verification/${run.id}/`) },
    ],
  },
];

/** Render the stats block as rows, skipping nested objects and nulls. */
const LABEL: Record<string, string> = {
  inputPages: 'Pages with no botanical name',
  candidates: 'Identifications examined',
  accepted: 'Accepted',
  rejected: 'Rejected',
  notAPlant: 'Not a plant (correctly has no binomial)',
  plantsAccepted: 'Plants accepted',
  plantsRejected: 'Plants rejected',
  contestedFlagged: 'Flagged as contested at identification',
  contestedRejected: 'Contested and rejected',
  contestedAcceptedAnyway: 'Contested but resolvable on the evidence',
  claimsChecked: 'Research claims checked',
  recovered: 'Resolved to a real paper',
  deleted: 'Deleted',
  matchedNothing: 'Matched nothing in PubMed',
  rejectedSpeciesKeywordOnly: 'Rejected: matched only by species keyword',
  pagesWithCitations: 'Pages now carrying citations',
  distinctPapers: 'Distinct papers indexed',
  papersWithDoi: 'Papers with a DOI',
  ledgerEntries: 'Records examined',
  acceptedEntries: 'Published',
  rejectedEntries: 'Rejected',
  panelAccepted: 'Passed the judge panel',
  publishedAfterValidation: 'Published after schema validation',
  failedValidation: 'Failed schema validation after passing the panel',
  metaSampled: 'Accepted records re-audited',
  metaAgreed: 'Re-audit agreed with the panel',
  metaDisagreed: 'Re-audit overturned the panel',
};

const rows = Object.entries(s)
  .filter(([, v]) => v !== null && typeof v !== 'object')
  .map(([k, v]) => [LABEL[k] ?? k, v as number]);

const byCategory = s.byCategory as Record<string, { accepted: number; rejected: number }> | undefined;
const byTier = s.byTier as Record<string, number> | undefined;
const byStage = s.rejectedByStage as Record<string, number> | undefined;
---
<Base title={`${run.title} · Verification · ${SITE_NAME}`} description={description} canonical={`/verification/${run.id}/`} jsonld={jsonld}>
  <Crumbs trail={[{ label: 'Verification', href: '/verification/' }, { label: run.title }]} />
  <h1>{run.title}</h1>

  <p class="answer">{run.question} {run.note}</p>

  <h2>How it was checked</h2>
  <ol>
    {run.method.map((m: string) => <li>{m}</li>)}
  </ol>

  <h2>What came out</h2>
  <div class="tablewrap">
    <table class="facts">
      <tbody>
        {rows.map(([k, v]) => (
          <tr><th scope="row">{k}</th><td style="text-align:right;font-variant-numeric:tabular-nums">{v}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  {byCategory && (
    <>
      <h2>By what the entry turned out to be</h2>
      <p>
        Most rejections are not mistakes. A bhasma, a purified salt, an isolated compound or
        an animal-derived drug has no botanical binomial, and recording that is the correct
        outcome rather than a gap.
      </p>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Category</th><th style="text-align:right">Accepted</th><th style="text-align:right">Rejected</th></tr></thead>
          <tbody>
            {Object.entries(byCategory).sort((a, b) => (b[1].accepted + b[1].rejected) - (a[1].accepted + a[1].rejected)).map(([cat, n]) => (
              <tr>
                <td>{cat}</td>
                <td style="text-align:right;font-variant-numeric:tabular-nums">{n.accepted}</td>
                <td style="text-align:right;font-variant-numeric:tabular-nums">{n.rejected}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {byTier && (
    <>
      <h2>Surviving papers by study type</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Tier</th><th style="text-align:right">Papers</th></tr></thead>
          <tbody>
            {Object.entries(byTier).map(([t, n]) => (
              <tr><td>{t}</td><td style="text-align:right;font-variant-numeric:tabular-nums">{n}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {byStage && Object.keys(byStage).length > 0 && (
    <>
      <h2>Where rejections happened</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Stage</th><th style="text-align:right">Rejected</th></tr></thead>
          <tbody>
            {Object.entries(byStage).map(([st, n]) => (
              <tr><td>{st}</td><td style="text-align:right;font-variant-numeric:tabular-nums">{n}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {run.examples && run.examples.length > 0 && (
    <>
      <h2>Worked rejections</h2>
      <p>The rate says less than the reasoning does. These are real cases from this run.</p>
      <dl>
        {run.examples.map((e: any) => (
          <>
            <dt><code>{e.slug}</code>{e.candidate ? <> — proposed <em>{e.candidate}</em></> : null}</dt>
            <dd>{e.basis}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {run.caveat && (
    <>
      <h2>Caveat</h2>
      <p>{run.caveat}</p>
    </>
  )}

  <p class="meta">
    Full ledger: <a href={rel('/verification.json')}>/verification.json</a>.
    Method overview: <a href={rel('/verification/')}>all verification runs</a>.
  </p>
</Base>
