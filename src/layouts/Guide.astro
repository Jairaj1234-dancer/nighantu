---
import Base from './Base.astro';
import ProductModule from '../components/ProductModule.astro';
import CiteThis from '../components/CiteThis.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE_NAME, PUBLISHER, abs, rel } from '../lib/site';
import { pageDates } from '../lib/dates';

interface Props { entry: any; siblings: any[] }
const { entry, siblings } = Astro.props;
const d = entry.data;
const canonical = d.slug === 'shirodhara' ? '/shirodhara/' : `/shirodhara/${d.slug}/`;
const { published, modified } = pageDates('guide', d.slug);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${abs(canonical)}#article`,
  headline: d.title,
  description: d.answer,
  inLanguage: 'en',
  isAccessibleForFree: true,
  datePublished: published,
  dateModified: modified,
  mainEntityOfPage: abs(canonical),
  about: {
    '@type': 'DefinedTerm',
    name: 'Shirodhara',
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: SITE_NAME, url: abs('/') },
  },
  author: { '@type': 'Organization', name: PUBLISHER, url: abs('/') },
  publisher: { '@id': `${abs('/')}#organization` },
};

const faqSchema = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f: any) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nighantu', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Shirodhara', item: abs('/shirodhara/') },
    ...(d.slug === 'shirodhara'
      ? []
      : [{ '@type': 'ListItem', position: 3, name: d.title, item: abs(canonical) }]),
  ],
};
---
<Base
  title={`${d.title} · ${SITE_NAME}`}
  description={d.description ?? d.answer}
  canonical={canonical}
  jsonld={[article, breadcrumbs, ...(faqSchema ? [faqSchema] : [])]}
>
  <article>
    <Crumbs
      trail={d.slug === 'shirodhara'
        ? [{ label: 'Shirodhara' }]
        : [{ label: 'Shirodhara', href: '/shirodhara/' }, { label: d.title }]}
    />
    <h1>{d.title}</h1>
    <p class="answer">{d.answer}</p>

    <div class="prose"><slot /></div>

    {d.faq.length > 0 && (
      <section>
        <h2>Common questions</h2>
        {d.faq.map((f: any) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}
      </section>
    )}

    <nav aria-label="Shirodhara guide">
      <h2>The rest of this guide</h2>
      <ul class="grid">
        {siblings.filter((s) => s.slug !== d.slug).map((s) => (
          <li class="card">
            <a href={rel(s.slug === 'shirodhara' ? '/shirodhara/' : `/shirodhara/${s.slug}/`)}>{s.title}</a>
            <p>{s.description ?? ''}</p>
          </li>
        ))}
      </ul>
    </nav>

    {d.products && <ProductModule slug={d.products} />}
    <CiteThis title={d.title} canonical={canonical} modified={modified} />

    <p class="disclaimer">
      Educational reference only. Shirodhara is a traditional external practice; nothing here is
      medical advice or a claim that it treats any condition. If you have a medical condition, are
      pregnant, or are unsure, consult a qualified practitioner before booking or attempting it.
      See our <a href={rel('/editorial-standards/')}>editorial standards</a>.
    </p>
  </article>
</Base>
