---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { SITE_NAME, rel } from '../lib/site';
import ledger from '../data/page-dates.json';

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  wide?: boolean;
  /** Path without extension where this page's .md and .jsonld twins live, if it has them. */
  twins?: string;
}
const { title, description, canonical, jsonld, wide = false , twins } = Astro.props;
// From the content ledger, not the clock: a build-time year would rewrite every
// page on 1 January and trigger a full, pointless resubmission.
const year = Math.max(
  ...Object.values(ledger as Record<string, { modified: string }>).map((e) => Number(e.modified.slice(0, 4))),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Montserrat:wght@400;600&display=swap"
    />
    <link rel="sitemap" href={rel('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={rel('/rss.xml')} />
    {/*
      ADVERTISE THE MACHINE TWINS FROM THE HEAD, which is how every cited reference database does
      it and how this site did not. The markdown twin existed and was mentioned only in llms.txt
      and as a footer link; the JSON-LD record did not exist at all. PubChem advertises its
      per-compound JSON with exactly this element, and a consumer should not have to read a
      separate file to learn the convention.

      Emitted only where the twins are actually built, which is the content collections: a hub
      page like /datasets/ has no .md or .jsonld and must not claim one, or site-audit would
      rightly report an advertised-but-absent URL.
    */}
    {twins && (
      <>
        <link rel="alternate" type="text/markdown" title={`${SITE_NAME} (Markdown)`} href={rel(`${twins}.md`)} />
        <link rel="alternate" type="application/ld+json" title={`${SITE_NAME} (JSON-LD record)`} href={rel(`${twins}.jsonld`)} />
      </>
    )}
    <Seo title={title} description={description} canonical={canonical} jsonld={jsonld} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="inner">
        <a class="brand" href={rel('/')}>Age Ayurveda <span>Nighantu</span></a>
        <nav aria-label="Sections">
          <a href={rel('/herb/')}>Herbs</a>
          <a href={rel('/formulation/')}>Formulations</a>
          <a href={rel('/device/')}>Instruments</a>
          <a href={rel('/shirodhara/')}>Shirodhara</a>
          <a href={rel('/practice/')}>Practices</a>
          <a href={rel('/glossary/')}>Glossary</a>
          <a href={rel('/research/')}>Research</a>
          <a href={rel('/verification/')}>Verification</a>
          <a href={rel('/about/')}>About</a>
        </nav>
      </div>
    </header>

    <main id="main" class={wide ? 'wrap-wide' : 'wrap'}>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap-wide">
        <nav aria-label="Site">
          <a href={rel('/about/')}>About</a>
          <a href={rel('/how-we-source/')}>How we source</a>
          <a href={rel('/editorial-standards/')}>Editorial standards</a>
          <a href={rel('/dravyaguna/')}>Dravyaguna</a>
          <a href={rel('/compounds/')}>Constituents</a>
          <a href={rel('/family/')}>Families</a>
          <a href={rel('/verification/')}>Verification</a>
          <a href={rel('/reviewers/')}>Reviewers</a>
          <a href={rel('/corrections/')}>Corrections</a>
          <a href={rel('/cite/')}>Cite</a>
          <a href={rel('/llms.txt')}>llms.txt</a>
        </nav>
        <p>
          {SITE_NAME} is published by Age Ayurveda. Educational reference only; nothing
          here is medical advice. <strong>Consult a qualified vaidya before acting on anything
          you read here</strong>, and raise any interaction with prescribed medication with the
          prescriber.
        </p>
        <p>&copy; {year} Age Ayurveda. Monograph text incorporates material from the Amidha
          Ayurveda Herb Database under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.</p>
      </div>
    </footer>
  </body>
</html>
