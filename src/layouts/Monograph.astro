---
import Base from './Base.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ProductModule from '../components/ProductModule.astro';
import References from '../components/References.astro';
import Safety from '../components/Safety.astro';
import ReviewCredit from '../components/ReviewCredit.astro';
import NameForms from '../components/NameForms.astro';
import EvidenceSummary from '../components/EvidenceSummary.astro';
import { reviewPageNode } from '../lib/review';
import Composition from '../components/Composition.astro';
import CiteThis from '../components/CiteThis.astro';
import duplicates from '../data/duplicates.json';
import taxonomy from '../data/taxonomy.json';
import Crumbs from '../components/Crumbs.astro';
import { SITE_NAME, PUBLISHER, abs, rel } from '../lib/site';
import { pageDates } from '../lib/dates';

interface Props { entry: any; sectionLabel: string; sectionHref: string }
const { entry, sectionLabel, sectionHref } = Astro.props;
const d = entry.data;

/**
 * External identifiers for this page's subject, read from the committed GBIF crosswalk.
 *
 * Only exact or near-exact matches are carried. taxonomy.json records a `matchType` for every
 * resolution precisely so a fuzzy hit is never read as a fact, and asserting `sameAs` is a much
 * stronger claim than printing a match type in a table: it says these two URIs denote the same
 * thing. A FUZZY match must not become a sameAs.
 */
const externalIds = (() => {
  const sameAs: string[] = [];
  const identifier: { '@type': string; propertyID: string; value: string }[] = [];
  if (!d.botanical) return { sameAs, identifier };
  const taxa = (taxonomy as any).taxa ?? [];
  const t = taxa.find((x: any) => x.pages?.some((p: any) => p.kind === d.kind && p.slug === d.slug))
    ?? taxa.find((x: any) => String(x.query ?? '').toLowerCase() === String(d.botanical).toLowerCase());
  if (!t) return { sameAs, identifier };
  const exact = /^(EXACT|ACCEPTED)$/i.test(String(t.matchType ?? ''));
  if (t.wikidata) { sameAs.push(`https://www.wikidata.org/wiki/${t.wikidata}`); identifier.push({ '@type': 'PropertyValue', propertyID: 'Wikidata', value: t.wikidata }); }
  if (t.gbifKey && exact) { sameAs.push(`https://www.gbif.org/species/${t.gbifKey}`); identifier.push({ '@type': 'PropertyValue', propertyID: 'GBIF', value: String(t.gbifKey) }); }
  // The field is ncbiTaxid, lower-case d. Spelled ncbiTaxId first, which silently produced zero
  // of these across 334 pages: a wrong key name reads as absent data, not as an error.
  if (t.ncbiTaxid) identifier.push({ '@type': 'PropertyValue', propertyID: 'NCBI:txid', value: String(t.ncbiTaxid) });
  return { sameAs, identifier };
})();
/**
 * Where this page's canonical points.
 *
 * 29 pages in this corpus are the same drug as another page under a different name:
 * neem and nimba, turmeric and haridra, manjishtha and manjistha. Each keeps its URL
 * and its content, because a reader arriving on either name should land somewhere
 * useful and the classical, Hindi and English names are all in real use. What they
 * stop doing is competing. A retrieval index that clusters near-duplicates picks one
 * representative on its own; declaring the primary here means it picks the one we
 * chose, and the signal consolidates instead of splitting.
 *
 * Which pages are aliases was decided by reading them, not by name similarity. Pages
 * that share a species but are genuinely different drugs stay independent: nutmeg and
 * mace both come from Myristica fragrans, fenugreek seed and leaf have different
 * markers and doses, and Guduchi satva is a derived preparation rather than a synonym.
 */
const selfUrl = `${sectionHref}${d.slug}/`;
const aliasOf = (duplicates as any).aliases?.[d.slug];
const primaryUrl = aliasOf ? `${sectionHref}${aliasOf.primary}/` : '';
const canonical = primaryUrl || selfUrl;
// entry.collection is the content directory, which is exactly how the ledger is keyed.
// d.kind is the record's own label and does not always match: reference records say "hub".
const { published, modified } = pageDates(entry.collection ?? d.kind, d.slug);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${abs(selfUrl)}#article`,
  headline: d.title,
  description: d.answer,
  inLanguage: 'en',
  isAccessibleForFree: true,
  datePublished: published,
  dateModified: modified,
  mainEntityOfPage: abs(selfUrl),
  // DefinedTerm rather than a medical schema type: this is reference material
  // about a substance, not a claim about treating anything.
  about: {
    '@type': 'DefinedTerm',
    /**
     * The SAME @id the knowledge graph already mints for this page's subject, so the page and the
     * graph describe one entity rather than two.
     *
     * A sweep of the reference sites that AI engines measurably cite found this to be the one
     * technical habit they all share and this site did not: identity wired into the page's own
     * markup. Wikipedia puts sameAs and mainEntity pointing at the Wikidata entity URI directly in
     * its page JSON-LD; PubChem advertises a per-record JSON endpoint from a link rel=alternate;
     * PubMed carries the PMID, PMCID and DOI in citation_* meta. Meanwhile this site printed
     * "GBIF 2928840 · Wikidata Q852660 · NCBI Taxonomy 126910" in the visible body, held the whole
     * crosswalk in taxonomy.json, and already emitted a Plant node at this exact #entity id inside
     * knowledge-graph.jsonld with sameAs to Wikidata and GBIF, and the page's own structured data
     * pointed at none of it. Nothing new is being asserted here: the identifiers were already
     * published, just not where a parser of this page would look.
     */
    '@id': `${abs(selfUrl)}#entity`,
    name: d.title,
    ...(d.botanical ? { alternateName: d.botanical } : {}),
    ...(externalIds.sameAs.length ? { sameAs: externalIds.sameAs } : {}),
    ...(externalIds.identifier.length ? { identifier: externalIds.identifier } : {}),
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: SITE_NAME, url: abs('/') },
  },
  author: { '@type': 'Organization', name: PUBLISHER, url: abs('/') },
  publisher: { '@id': `${abs('/')}#organization` },
  ...(d.sources?.length ? { citation: d.sources } : {}),
  license: 'https://creativecommons.org/licenses/by/4.0/',
};

const webPage = reviewPageNode(
  d.kind, d.slug, abs(selfUrl), `${abs(selfUrl)}#article`, abs('/reviewers/'),
);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nighantu', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: sectionLabel, item: abs(sectionHref) },
    { '@type': 'ListItem', position: 3, name: d.title, item: abs(selfUrl) },
  ],
};
---
<Base
  twins={`/${entry.collection}/${d.slug}`}
  title={`${d.title} · ${SITE_NAME}`}
  description={d.answer}
  canonical={canonical}
  jsonld={[jsonld, ...(webPage ? [webPage] : []), breadcrumbs]}
>
  <article>
    <Crumbs trail={[{ label: sectionLabel, href: sectionHref }, { label: d.title }]} />
    <h1>{d.title}</h1>
    {d.botanical && <p class="binomial">{d.botanical}</p>}

    <p class="answer">{d.answer}</p>

    <KeyFacts
      kind={d.kind}
      slug={d.slug}
      botanical={d.botanical}
      family={d.family}
      sanskrit={d.sanskrit}
      ayurvedicCategory={d.ayurvedicCategory}
      whoStatus={d.whoStatus}
      aliases={d.aliases}
    />

    <NameForms kind={d.kind} slug={d.slug} />

    {/*
      Placed directly after Key facts and the names, which is still inside the first screen on a
      monograph, because that is where the measurement says cited passages come from: 44.2% of
      cited passages in a study of 18,012 AI citations fell in the first 30% of the page.
    */}
    <EvidenceSummary kind={d.kind} slug={d.slug} />

    {aliasOf && (
      <p class="aliasnote">
        This entry and <a href={rel(primaryUrl)}>{aliasOf.primary.replace(/-/g, ' ')}</a> describe
        the same drug, <em>{aliasOf.taxon}</em>, under different names. Both pages are kept because
        both names are in use; the other is treated as the primary record for citation.
      </p>
    )}

    <div class="prose"><slot /></div>

    <Composition kind={d.kind} slug={d.slug} />

    <Safety kind={d.kind} slug={d.slug} />

    <References kind={d.kind} slug={d.slug} />

    <ReviewCredit kind={d.kind} slug={d.slug} />

    <ProductModule slug={d.slug} />
    <CiteThis title={d.title} canonical={canonical} modified={modified} />

    <p class="disclaimer">
      <strong>Consult a qualified vaidya before acting on anything here.</strong> Ayurvedic
      practice is prescribed to a person, not to a condition: the same dravya is given, withheld
      or substituted depending on your constitution, your agni, the season and what else you are
      already taking. A page cannot know any of that. Self-prescribing from a reference is how
      the wrong preparation, the wrong dose or the wrong anupana gets used.
    </p>
    <p class="disclaimer">
      Educational reference only. Nothing on this page is medical advice, a diagnosis, or a
      recommendation to take anything. Traditional uses and research findings are reported as
      published, not as claims about what any product does. If you take prescribed medication,
      raise any interaction with the prescriber rather than acting on a page. See our
      <a href={rel('/editorial-standards/')}>editorial standards</a>.
    </p>
  </article>
</Base>
