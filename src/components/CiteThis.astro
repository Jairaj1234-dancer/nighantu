---
import { SITE_NAME, PUBLISHER, abs, rel } from '../lib/site';
import { prettyDate } from '../lib/dates';

interface Props { title: string; canonical: string; modified: string }
const { title, canonical, modified } = Astro.props;
const url = abs(canonical);
const stamp = modified;
const pretty = prettyDate(modified);
---
<aside class="cite">
  <strong>Cite this page.</strong>
  {PUBLISHER}. &ldquo;{title}.&rdquo; <i>{SITE_NAME}</i>. Last reviewed {pretty}.
  <code>{url}</code>
  <br />
  <span>Machine-readable source: <a href={rel(`${canonical.replace(/\/$/, '')}.md`)}>Markdown</a>. Reviewed {stamp}.</span>
</aside>
