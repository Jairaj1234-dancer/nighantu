---
/**
 * The review credit, shown only on pages a named practitioner has actually read.
 *
 * Scope comes from src/data/review.json via src/lib/review.ts, which resolves a page
 * against the recorded batches. A page outside every batch renders nothing at all: a herb
 * page beginning with F has not been reviewed and must not look as though it has.
 *
 * The affiliation is deliberately absent here. The compliance gate blocks heritage framing
 * on every page but /reviewers/, where it belongs as a credential a reader can check, so
 * this names the reviewer and links there.
 */
import { reviewer, reviewFor, formatReviewDate } from '../lib/review';
import { rel } from '../lib/site';

interface Props { kind: string; slug: string }
const { kind, slug } = Astro.props;

const entry = reviewFor(kind, slug);
---
{entry && (
  <p class="reviewed">
    Reviewed by <strong>{reviewer.name}</strong>, {reviewer.qualification}, on {formatReviewDate(entry.reviewedOn)}.
    <a href={rel('/reviewers/')}>What that review covered</a>.
  </p>
)}

<style>
  .reviewed {
    margin: 1.75rem 0 0;
    padding: .6rem 0 0;
    border-top: 1px solid var(--rule);
    font-size: .9rem;
    color: var(--ink-soft);
  }
  .reviewed strong { color: var(--ink); font-weight: 600; }
</style>
