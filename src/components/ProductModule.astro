---
import data from '../data/products.json';
import { STORE } from '../lib/site';

interface Props { slug: string }
const { slug } = Astro.props;

const handles: string[] = (data.map as Record<string, string[]>)[slug] ?? [];
const items = handles
  .map((h) => ({ handle: h, ...(data.products as Record<string, any>)[h] }))
  .filter((p) => p.title);
---
{items.length > 0 && (
  <section class="product" data-product-module aria-labelledby="available-heading">
    <h2 id="available-heading">Available from Age Ayurveda</h2>
    <p class="note">
      This encyclopedia is published by Age Ayurveda. The products below are ours, and are
      listed here because they contain or use what this page describes.
    </p>
    <ul>
      {items.map((p) => (
        <li>
          {/*
            * Real alt text, not an empty one.
            *
            * These 129 thumbnails all carried alt="", which Bing flags across 67 pages. An
            * empty alt is the correct markup for a decorative image, and a product photograph
            * next to a named product is not decorative: it is the only part of this row a
            * sighted reader gets and a screen reader user does not.
            *
            * The product name alone, deliberately. The alt sits inside data-product-module,
            * which scripts/audit.mjs scans for disease terms and claim verbs, so anything
            * describing what the product is for would both fail that gate and be a claim made
            * in alt text where no reader can check it.
            */}
          <img src={p.image} alt={`${p.title}, product photograph`} loading="lazy" width="68" height="68" />
          <div>
            <a
              class="pname"
              href={`${STORE}/products/${p.handle}?utm_source=nighantu&utm_medium=reference&utm_campaign=${slug}`}
              rel="noopener"
            >{p.title}</a>
            <span class="pline">{p.line}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
