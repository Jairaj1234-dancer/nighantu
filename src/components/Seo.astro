---
import { SITE_NAME, PUBLISHER, STORE, abs, WIKIDATA_PUBLISHER} from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical: string;      // site-relative, e.g. /herb/ashwagandha/
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, canonical, jsonld } = Astro.props;

/**
 * Drop the site-name suffix from a title that is too long to survive a result page.
 *
 * Every page composes its own title as "Page name · Age Ayurveda Nighantu". That suffix is
 * 24 characters, so any page name over about forty is pushed past the length a search engine
 * will show, and Bing flags it. Twenty-five pages were over sixty-five characters, the worst
 * at eighty-eight.
 *
 * The suffix is the part that goes, because it is the part a reader least needs: the result
 * already shows the domain, and a truncated title loses the words that identify the page. The
 * site name stays in `og:site_name` either way, which is where a platform reads it from.
 *
 * Trimming here rather than at twenty-odd call sites keeps one rule in one place, and keeps a
 * long new page title from quietly reintroducing the problem.
 */
const SUFFIX = ` · ${SITE_NAME}`;
const MAX = 65;
const pageTitle = (() => {
  const t = String(title ?? '');
  if (t.length <= MAX || !t.endsWith(SUFFIX)) return t;
  const trimmed = t.slice(0, -SUFFIX.length);
  return trimmed.length ? trimmed : t;
})();
const url = abs(canonical);

const organization = {
  '@type': 'Organization',
  '@id': `${abs('/')}#organization`,
  name: PUBLISHER,
  url: STORE,
  sameAs: [STORE, abs('/'), WIKIDATA_PUBLISHER],
};

const blocks = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${abs('/')}#website`,
    name: SITE_NAME,
    url: abs('/'),
    publisher: organization,
  },
  ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : []),
];
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="article" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={SITE_NAME} />
<meta name="twitter:card" content="summary" />
{blocks.map((b) => (
  <script type="application/ld+json" set:html={JSON.stringify(b)} is:inline />
))}
