---
/**
 * Composition table, transcribed from the Ayurvedic Formulary of India.
 *
 * Every row is the AFI's own: ingredient, plant part and quantity as printed, in the
 * printed order, cited to part and entry number. Nothing is inferred. The companion
 * database had ingredient proportions for these formulations too, but they were
 * AI-curated and never checked, so they are not the source here; they were only used
 * to find disagreements, and where they disagreed with the AFI the AFI stands.
 *
 * A row whose OCR had to be corrected says so, because the correction is ours, not the
 * book's. A row the verifier could not read is shown as illegible rather than guessed.
 */
import compositions from '../data/composition.json';
import manifest from '../data/manifest.json';
import { rel } from '../lib/site';

interface Props { kind: string; slug: string }
const { kind, slug } = Astro.props;

const rec = kind === 'formulation' ? (compositions as any).records?.[slug] : null;

// Expansions as listed in the AFI's "Abbreviations for parts of plants". Only the ones
// that could be read unambiguously from the scan; anything else is shown as printed.
const PARTS: Record<string, string> = {
  'Rt.': 'root', 'Rz.': 'rhizome', 'Fr.': 'fruit', 'Sd.': 'seed', 'Lf.': 'leaf', 'Fl.': 'flower',
  'St.': 'stem', 'St. Bk.': 'stem bark', 'Rt. Bk.': 'root bark', 'Ht. Wd.': 'heart wood',
  'Pl.': 'whole plant', 'P.': 'pericarp', 'Exd.': 'exudate', 'Bl.': 'bulb', 'Ol.': 'oil',
  'Dr. Fr.': 'dry fruit', 'Dr. Sd.': 'dry seed', 'Ifl.': 'inflorescence', 'Gl.': 'gall',
  'Stmn.': 'stamens', 'Fl. Bd.': 'flower bud', 'Rt. Tr.': 'root tuber', 'St. Tr.': 'stem tuber',
  'Fr. R.': 'fruit rind', 'Enm.': 'endosperm',
  // From the same key, needed by the Cyavanaprasa entry: the brhat pancamula are taken as
  // either root or stem bark, and tugaksiri is bamboo's silicaceous concretion.
  'Rt./St.Bk.': 'root or stem bark', 'Rt./St. Bk.': 'root or stem bark',
  'S.C.': 'silicaceous concretion',
};
const norm = (p: string) => p.replace(/\s+/g, ' ').replace(/\s*\.\s*/g, '. ').trim().replace(/\s$/, '');
const partLabel = (p: string | null) => {
  if (!p) return '';
  // Raw first. `norm` inserts a space after every full stop, which turns "Rt./St.Bk." into
  // "Rt. /St. Bk." and "S.C." into "S. C.", so multi-stop abbreviations never matched a key.
  if (PARTS[p]) return PARTS[p];
  const k = norm(p);
  return PARTS[k] ?? PARTS[k.replace(/\.$/, '') + '.'] ?? p;
};

// Link an ingredient only when a herb page with exactly that slug exists. A fuzzy match
// would link Patola to Patala, which are different plants.
const herbSlugs = new Set(((manifest as any).pages ?? []).filter((p: any) => p.kind === 'herb').map((p: any) => p.slug));
const slugOf = (s: string) => s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const linkFor = (r: any) => [r.gloss, r.name].map((x) => x && slugOf(x)).find((s) => s && herbSlugs.has(s));

/**
 * Mark the cell that is actually unreadable, not the whole row.
 *
 * `illegible` is a row-level flag, and it used to gate the INGREDIENT NAME cell, so a row
 * whose part abbreviation was damaged printed "illegible in the source scan" in place of a
 * name the transcriber had read perfectly well. That was 174 of the 176 flagged rows: the
 * one cell that was legible was the one being hidden. The transcriptions mark an unreadable
 * cell inline, so the marker decides the cell, and a row flag alone no longer hides a name.
 */
const marked = (v: any) => /^\[illegible/i.test(String(v ?? ''));

/**
 * Three different things, and they must not look alike:
 *  - an empty cell is NOT damage. 248 rows legitimately have no part, because water, milk,
 *    jaggery, sugar and mineral ingredients have none. Those print blank.
 *  - a cell the transcriber marked "[illegible: ...]" is damage.
 *  - a part that still carries scan garbage is damage too, and was printing raw as "P1."
 *    or "?1." beside real abbreviations. No genuine part abbreviation contains a digit or a
 *    question mark, so that is a safe test.
 */
const partCell = (v: any) => {
  if (v == null || String(v).trim() === '') return { text: '', damaged: false };
  if (marked(v) || /[?0-9]/.test(String(v))) return { text: '', damaged: true };
  return { text: partLabel(String(v)), damaged: false };
};
const quantityCell = (v: any) => (marked(v) || v == null || String(v).trim() === ''
  ? { text: '', damaged: true }
  : { text: String(v), damaged: false });
---
{rec && (
  <section class="composition" aria-labelledby="composition-heading">
    <h2 id="composition-heading">Composition</h2>
    <p class="composition-note">
      As given in the <cite>Ayurvedic Formulary of India</cite>, Part {rec.afiPart}, entry {rec.entryNumber}
      ({rec.entryHeading}){rec.classicalSource ? <>, which cites {rec.classicalSource}</> : ''}.
      Names, parts and quantities are transcribed as printed and checked row by row against the
      book. Manufacturers' versions of a classical formulation can differ from the formulary.
    </p>
    {/*
      Said in the same breath as the attribution, not in a footnote. Where the formulary has no
      entry under this page's name, a reader who is told only "entry 7:35 (SUDARSANA CURNA)" can
      reasonably take that for the formulary's romanisation of the page's subject. On a
      maha-prefixed page it is more likely a different formulation, so the page has to say so
      where the claim is made. Written by scripts/check-afi-naming.mjs.
    */}
    {rec.entryNameNote && (
      <p class="composition-note composition-warn">{rec.entryNameNote}</p>
    )}
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">#</th><th scope="col">Ingredient</th><th scope="col">Part</th><th scope="col">Quantity</th></tr></thead>
        <tbody>
          {rec.rows.map((r: any) => {
            const link = linkFor(r);
            /*
             * A structural row is the book's own furniture, not an ingredient: a sub-heading
             * printed inside the table ("Praksepa dravyas", the drugs added at the end) or a
             * continuation line ("reduced to 12.288 l."). It keeps its place in the order,
             * because dropping it would lose the structure, but it takes no number.
             */
            if (r.structural) {
              return (
                <tr class="structural">
                  <td />
                  <td colspan="2"><em>{r.name}</em></td>
                  <td>{quantityCell(r.quantity).damaged ? '' : quantityCell(r.quantity).text}</td>
                </tr>
              );
            }
            return (
              <tr>
                <td>{r.n}</td>
                <td>
                  {link ? <a href={rel(`/herb/${link}/`)}>{r.name}</a> : r.name}
                  {r.gloss && !marked(r.gloss) && <> ({r.gloss})</>}
                  {r.ocrCorrected && <span class="ocrnote" title={r.ocrCorrected}> *</span>}
                </td>
                <td>{partCell(r.part).damaged ? <em class="illegible">illegible</em> : partCell(r.part).text}</td>
                <td>
                  {quantityCell(r.quantity).damaged ? <em class="illegible">illegible</em> : quantityCell(r.quantity).text}
                  {/*
                    * The decoction's reduction, printed by the book on its own line. Without
                    * it the row states only the volume the water starts at, not the volume
                    * the formula uses, which understates what the entry specifies.
                    */}
                  {r.reduction && <><br /><span class="composition-note">{r.reduction}</span></>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {rec.rows.some((r: any) => partCell(r.part).damaged || quantityCell(r.quantity).damaged) && (
      <p class="composition-note">
        Cells marked illegible are damaged in the source scan. The ingredient name is shown
        where it was readable, and nothing is inferred to fill a gap.
      </p>
    )}
    {rec.rows.some((r: any) => r.ocrCorrected) && (
      <p class="composition-note">* The scanned text was damaged at this row and the name was read from the entry's own Sanskrit verse.</p>
    )}

    {/*
      * How many ingredients, with the rule named in the same sentence as the number.
      *
      * This exists because of Chyawanprash, where the site refused to print a count at all on
      * the grounds that sources said 45, 50 and 18. Verification showed that framing was
      * wrong: 45 is not a rival source, it is this same Formulary entry counted under a
      * different rule. The dispute was never between books, it was between people counting
      * rows, ingredients or plants and all calling the answer "ingredients".
      *
      * So a bare total is exactly what must not be published here, and scripts/audit.mjs
      * still blocks one in page prose. Every figure below carries its rule.
      */}
    {rec.counts && (
      <div class="composition-counts">
        <p>
          This entry lists <strong>{rec.counts.numberedRows} numbered rows</strong>, which are
          {' '}<strong>{rec.counts.distinctIngredients} distinct ingredients</strong>: {rec.counts.rowsListedTwice?.length === 2
            ? `${rec.counts.rowsListedTwice.join(' and ')} are each listed twice, added at different stages.`
            : 'some are listed twice, added at different stages.'}
          {' '}{rec.counts.notPlantMaterial?.length} of them are not plant material
          ({rec.counts.notPlantMaterial.map((x: string) => x.replace(/^\d+\.\s*/, '').toLowerCase()).join(', ')}),
          leaving <strong>{rec.counts.distinctPlantIngredients} distinct plant ingredients</strong>.
        </p>
        <p class="composition-note">
          A count of 45 that you may see elsewhere is this same formula under a different rule,
          not a different source: the distinct ingredients less the water, or the rows less
          water, ghee and honey. Counts of 50 or 18 do not correspond to this entry at all.
          The Formulary prints no total of its own, so every figure here is a derived count and
          only means anything with its rule attached.
        </p>
        {rec.counts.decoctionRangeAsPrinted && (
          <p class="composition-note">
            The preparation note reads “{rec.counts.decoctionRangeAsPrinted}”. That is a
            row range as printed, not a count of powdered herbs: row 38 is the decoction water
            itself, and the amalaka of row 37 is suspended whole in a cloth bundle rather than
            powdered.
          </p>
        )}
      </div>
    )}

    {/*
      * The Formulary's own dose and anupana for this entry.
      *
      * Attributed in the sentence rather than in a footnote, and that is the whole point. A
      * dose printed bare by a company that sells the substance is prescribing; the same
      * figure reported as the Formulary's, next to the entry number it came from, is
      * reference. scripts/audit.mjs bars a dose from the answer block for exactly this
      * reason and allows it in the body, where the framing travels with it.
      *
      * Anupana is given untranslated because it has no English equivalent: it is the vehicle
      * a preparation is taken with, and calling it a "carrier" or "with" loses that it is
      * part of the prescription rather than a serving suggestion.
      */}
    {(rec.dose || rec.anupana) && (
      <p class="composition-dose">
        {rec.dose && (
          <>
            The Formulary gives the dose as <strong>{rec.dose}</strong>
            {rec.doseOcrNote && <span class="composition-note"> ({rec.doseOcrNote})</span>}
          </>
        )}
        {rec.dose && rec.anupana && ', with '}
        {!rec.dose && rec.anupana && 'The Formulary gives the anupana, the vehicle it is taken with, as '}
        {rec.anupana && (
          <>
            {rec.dose && <>anupana, the vehicle it is taken with, of </>}
            <strong>{rec.anupana}</strong>
          </>
        )}
        {'. '}
        <span class="composition-note">
          This is what the Formulary records for the classical preparation. It is not a dose
          for any product, and not advice to take anything.
        </span>
      </p>
    )}
    <p class="composition-note"><a href={rec.sourceUrl} rel="noopener">Source scan of the formulary</a></p>
  </section>
)}
